:root{
  --curo-bg:#f7f8fb;
  --curo-card:#ffffff;
  --curo-accent:#0f62fe;
  --curo-accent-600:#0747a6;
  --curo-muted:#6b7280;
  --curo-border:#e6e9ef;
  --curo-radius:12px;
  --curo-shadow:0 6px 20px rgba(16,24,40,0.06);
  --curo-gap:16px;
  --curo-input-height:44px;
  --curo-transition:180ms ease;
  --max-width:980px;
}

.curohelp-form{
  max-width:var(--max-width);
  margin:18px auto;
  background:#fff;
  border-radius:var(--curo-radius);
  box-shadow:var(--curo-shadow);
  padding:22px;
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial;
  color:#111827;
  box-sizing:border-box;
}

.curohelp-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin-bottom:14px;
}

.curohelp-top h2{
  margin:0;
  font-size:20px;
  font-weight:600;
}

.progressbar{
  width:48%;
  display:flex;
  gap:8px;
}

.progress-step{
  flex:1 1 0;
  height:8px;
  background:var(--curo-border);
  border-radius:999px;
  transition:background var(--curo-transition);
}

.progress-step.active{
  background:var(--curo-accent);
}

label.field{
  display:flex;
  flex-direction:column;
  gap:6px;
  font-size:13px;
  color:var(--curo-muted);
}

label.field input,
label.field select,
label.field textarea{
  height:var(--curo-input-height);
  padding:10px 12px;
  border:1px solid var(--curo-border);
  border-radius:8px;
  font-size:14px;
  color:#0b1220;
}

label.field textarea{
  height:auto;
  min-height:120px;
}

label.field input:focus,
label.field textarea:focus,
label.field select:focus{
  border-color:var(--curo-accent);
  box-shadow:0 0 0 3px rgba(15,98,254,0.1);
  outline:none;
}

#references-list .reference-row{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
  margin-bottom:10px;
}

.curohelp-actions{
  display:flex;
  gap:10px;
  justify-content:flex-end;
  margin-top:16px;
}

.button-primary{
  background:var(--curo-accent);
  color:#fff;
  border:none;
  padding:12px 20px;
  border-radius:10px;
  font-weight:600;
  cursor:pointer;
}

.button-secondary{
  background:#fff;
  color:var(--curo-accent-600);
  border:1px solid var(--curo-border);
  padding:10px 16px;
  border-radius:10px;
  font-weight:600;
  cursor:pointer;
}

#curohelp-preloader{
  position:fixed;
  inset:0;
  display:none;
  align-items:center;
  justify-content:center;
  background:rgba(0,0,0,0.4);
  z-index:9999;
}

#curohelp-preloader .loader{
  width:50px;
  height:50px;
  border:6px solid rgba(255,255,255,0.3);
  border-top-color:#fff;
  border-radius:50%;
  animation:spin 1s linear infinite;
}

@keyframes spin{
  to{transform:rotate(360deg);}
}

#curohelpMessage{
  margin-top:12px;
  font-size:14px;
}

@media(max-width:780px){
  #references-list .reference-row{
    grid-template-columns:1fr;
  }
  .progressbar{
    width:100%;
  }
}





/* -------------------------------------------------
   FORM WRAPPER
------------------------------------------------- */
#cm-form.cm-form {
    max-width: 900px;
    margin: 40px auto;
    padding: 25px;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
    font-family: "Inter", Arial, sans-serif;
}

/* -------------------------------------------------
   STEP BADGES
------------------------------------------------- */
.cm-steps {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 25px;
}

.cm-step-badge {
    padding: 10px 16px;
    background: #f2f2f2;
    border-radius: 8px;
    font-size: 14px;
    cursor: pointer;
    transition: 0.2s;
    font-weight: 600;
}

.cm-step-badge:hover {
    background: #e4e4e4;
}

.cm-step-badge.active {
    background: #007bff;
    color: #fff;
}

/* -------------------------------------------------
   HEADINGS
------------------------------------------------- */
.cm-step h3 {
    font-size: 22px;
    margin-bottom: 12px;
    font-weight: 700;
}

.cm-step h4 {
    font-size: 17px;
    margin: 12px 0 6px;
    font-weight: 600;
}

/* -------------------------------------------------
   GRID LAYOUT
------------------------------------------------- */
.cm-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 18px;
    margin-bottom: 20px;
}

/* -------------------------------------------------
   LABELS & INPUTS
------------------------------------------------- */
.cm-form label {
    display: block;
    font-weight: 600;
    font-size: 14px;
    color: #333;
}

.cm-form input[type="text"],
.cm-form input[type="email"],
.cm-form input[type="number"],
.cm-form input[type="file"],
.cm-form textarea,
.cm-form select {
    width: 100%;
    padding: 10px 12px;
    margin-top: 6px;
    border: 1px solid #dcdcdc;
    border-radius: 8px;
    background: #fafafa;
    font-size: 14px;
    transition: border-color 0.25s, background 0.25s;
}

.cm-form textarea {
    height: 120px;
    resize: vertical;
}

.cm-form input:focus,
.cm-form textarea:focus,
.cm-form select:focus {
    border-color: #007bff;
    background: #ffffff;
    outline: none;
}

/* -------------------------------------------------
   CHECKBOXES LIST (ROLES, ACCOMMODATION, ETC.)
------------------------------------------------- */
.cm-roles-list label,
.cm-step label input[type="checkbox"] + span {
    display: flex;
    align-items: center;
    gap: 6px;
}

.cm-roles-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 6px 12px;
    margin-top: 12px;
    margin-bottom: 20px;
}

.cm-step label input[type="checkbox"] {
    width: 16px;
    height: 16px;
}

/* -------------------------------------------------
   FILE UPLOAD INPUTS
------------------------------------------------- */
.cm-step input[type="file"] {
    background: #fff;
    padding: 8px;
}

/* -------------------------------------------------
   REFERENCES
------------------------------------------------- */
#cm-references .ref {
    padding: 16px;
    background: #fafafa;
    border: 1px solid #e4e4e4;
    border-radius: 10px;
    margin-bottom: 14px;
}

/* Add Reference button */
#cm-add-reference {
    background: #28a745;
    color: #fff;
    padding: 10px 18px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    margin-top: 10px;
    font-weight: 600;
}
#cm-add-reference:hover {
    background: #218838;
}

/* -------------------------------------------------
   NAVIGATION BUTTONS
------------------------------------------------- */
.cm-actions {
    display: flex;
    justify-content: space-between;
    margin-top: 20px;
}

.cm-actions button {
    padding: 12px 26px;
    font-size: 15px;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    font-weight: 600;
    transition: 0.25s;
}

/* Next */
#cm-next {
    background: #007bff;
    color: #fff;
}
#cm-next:hover {
    background: #0063d4;
}

/* Previous */
#cm-prev {
    background: #e4e4e4;
    color: #333;
}
#cm-prev:hover {
    background: #d3d3d3;
}

/* Submit */
#cm-submit {
    background: #28a745;
    color: #fff;
}
#cm-submit:hover {
    background: #218838;
}

/* -------------------------------------------------
   RESPONSIVE
------------------------------------------------- */
@media (max-width: 600px) {
    .cm-steps {
        flex-direction: column;
    }
    
    .cm-actions {
        flex-direction: column;
        gap: 12px;
    }
}
		</style>
		<style type="text/css">/** Mega Menu CSS: fs **/</style>
</head>

