/* Front-end styling for Custom Agreements Manager */

.cam-agreement-wrapper {
    display: flex;
    justify-content: center;
    padding: 24px 16px;
}

.cam-agreement-card {
    max-width: 900px;
    width: 100%;
    background: #ffffff;
    border-radius: 14px;
    padding: 24px 22px 28px;
    box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    border: 1px solid rgba(148, 163, 184, 0.25);
}

.cam-agreement-success {
    background: #ecfdf3;
    border-left: 4px solid #16a34a;
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 14px;
    color: #14532d;
    margin-bottom: 12px;
}

.cam-agreement-error {
    background: #fef2f2;
    border-left: 4px solid #dc2626;
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 14px;
    color: #7f1d1d;
    margin-bottom: 12px;
}

.cam-agreement-error ul {
    padding-left: 18px;
    margin: 4px 0 0;
}

.cam-title {
    font-size: 24px;
    margin: 6px 0 2px;
}

.cam-subtitle {
    margin: 0 0 16px;
    color: #6b7280;
    font-size: 14px;
}

.cam-section-title {
    font-size: 16px;
    margin: 18px 0 10px;
    font-weight: 600;
}

.cam-agreement-details {
    margin-bottom: 20px;
}

.cam-badge-row {
    display: flex;
    justify-content: flex-end;
}

.cam-badge {
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
}

.cam-badge-pending {
    background-color: #fef3c7;
    color: #92400e;
}

.cam-badge-signed {
    background-color: #dcfce7;
    color: #166534;
}

.cam-agreement-doc {
    margin-top: 10px;
}

.cam-pdf-wrapper {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #e5e7eb;
}

.cam-pdf-embed {
    width: 100%;
    height: 550px;
}

.cam-link {
    color: #2563eb;
    text-decoration: none;
    font-weight: 500;
}

.cam-link:hover {
    text-decoration: underline;
}

.cam-signature-summary p {
    margin: 4px 0;
}

.cam-form {
    margin-top: 10px;
}

.cam-form-group {
    margin-bottom: 12px;
}

.cam-form-group label {
    font-weight: 500;
    display: block;
    margin-bottom: 4px;
}

.cam-input {
    width: 100%;
    border-radius: 8px;
    border: 1px solid #d1d5db;
    padding: 8px 10px;
    font-size: 14px;
}

.cam-input:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 1px rgba(37, 99, 235, 0.35);
}

.cam-input-file {
    padding: 4px;
}

.cam-help-text {
    font-size: 12px;
    color: #6b7280;
}

.cam-form-checkbox input[type="checkbox"] {
    margin-right: 6px;
}

.cam-checkbox-label {
    display: flex;
    align-items: center;
    font-size: 14px;
    cursor: pointer;
}

.cam-form-actions {
    margin-top: 16px;
}

.cam-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 9px 20px;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
}

.cam-button-primary {
    background: linear-gradient(135deg, #2563eb, #4f46e5);
    color: #ffffff;
    box-shadow: 0 16px 30px rgba(37, 99, 235, 0.35);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
}

.cam-button-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 20px 40px rgba(37, 99, 235, 0.45);
    color: #ffffff;
}

.cam-button-primary:active {
    transform: translateY(0);
    box-shadow: 0 10px 20px rgba(37, 99, 235, 0.35);
}

/* Responsive */
@media (max-width: 768px) {
    .cam-agreement-card {
        padding: 18px 16px 22px;
        box-shadow: 0 14px 30px rgba(15, 23, 42, 0.14);
    }
    .cam-pdf-embed {
        height: 420px;
    }
    .cam-title {
        font-size: 20px;
    }
}

@media (max-width: 480px) {
    .cam-agreement-wrapper {
        padding: 16px 8px;
    }
    .cam-pdf-embed {
        height: 360px;
    }
}

/* Admin styling for Custom Agreements Manager */

.cam-admin-wrap {
    max-width: 1100px;
}

.cam-admin-title {
    font-size: 26px;
    margin-bottom: 16px;
}

.cam-admin-card {
    background: #ffffff;
    border-radius: 10px;
    padding: 20px 24px;
    margin-top: 16px;
    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.06);
    border: 1px solid #e5e7eb;
}

.cam-admin-card--detail {
    margin-top: 24px;
}

.cam-admin-card--table {
    margin-top: 24px;
}

.cam-admin-card--filters {
    margin-top: 16px;
}

.cam-admin-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 24px;
}

.cam-admin-grid--filters {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: flex-end;
}

.cam-field {
    display: flex;
    flex-direction: column;
}

.cam-field label {
    font-weight: 600;
    margin-bottom: 4px;
}

.cam-field .description {
    font-size: 12px;
    color: #6b7280;
}

.cam-field-full {
    grid-column: 1 / -1;
}

.cam-field--actions {
    text-align: right;
}

.cam-input,
.cam-textarea,
.cam-filter-form .cam-input {
    border-radius: 6px;
    border: 1px solid #d1d5db;
    padding: 6px 10px;
    font-size: 14px;
}

.cam-textarea {
    min-height: 120px;
}

.cam-submit-wrap {
    margin-top: 16px;
}

.cam-button-primary,
.cam-button-secondary {
    border-radius: 999px;
    padding: 6px 18px;
    font-weight: 600;
    border: none;
}

.cam-button-primary {
    background: linear-gradient(135deg, #2563eb, #4f46e5);
    color: #ffffff;
    box-shadow: 0 10px 25px rgba(37, 99, 235, 0.4);
}

.cam-button-primary:hover {
    background: linear-gradient(135deg, #1d4ed8, #4338ca);
    color: #ffffff;
}

.cam-button-secondary {
    background: #f3f4f6;
    color: #111827;
}

.cam-button-secondary:hover {
    background: #e5e7eb;
    color: #111827;
}

.cam-required {
    color: #dc2626;
    margin-left: 3px;
}

.cam-table th,
.cam-table td {
    vertical-align: middle;
}

.cam-status {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.cam-status-pending {
    background-color: #fef3c7;
    color: #92400e;
}

.cam-status-signed {
    background-color: #dcfce7;
    color: #166534;
}

.cam-detail-table th {
    width: 180px;
}

/* Responsive admin */
@media (max-width: 960px) {
    .cam-admin-grid,
    .cam-admin-grid--filters {
        grid-template-columns: 1fr;
    }
    .cam-field--actions {
        text-align: left;
    }
}


