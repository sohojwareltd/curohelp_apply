					<div class="elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-e0b4ef6" data-id="e0b4ef6" data-element_type="column" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
			<div class="elementor-widget-wrap elementor-element-populated">
						<div class="elementor-element elementor-element-0c0abff elementor-widget elementor-widget-image" data-id="0c0abff" data-element_type="widget" data-widget_type="image.default">
				<div class="elementor-widget-container">
															<img loading="lazy" decoding="async" width="800" height="533" src="./Home _ Private Staff As A Service _ CuroHelp_files/teddy-3801504_1280-1024x682.jpg" class="attachment-large size-large wp-image-889" alt="" srcset="https://curohelp.com/wp-content/uploads/2025/06/teddy-3801504_1280-1024x682.jpg 1024w, https://curohelp.com/wp-content/uploads/2025/06/teddy-3801504_1280-300x200.jpg 300w, https://curohelp.com/wp-content/uploads/2025/06/teddy-3801504_1280-768x512.jpg 768w, https://curohelp.com/wp-content/uploads/2025/06/teddy-3801504_1280.jpg 1280w" sizes="(max-width: 800px) 100vw, 800px">															</div>
